[Unit]
Description=TSCQuestões
After=network-online.target tscquestoes-firewall.service
Wants=network-online.target tscquestoes-firewall.service

[Service]
Type=simple
User=tscquestoes
Group=tscquestoes
WorkingDirectory=/opt/tscquestoes/atual/app
EnvironmentFile=/etc/tscquestoes/ambiente
Environment=NODE_ENV=production
Environment=PORT=80
Environment=HOSTNAME=0.0.0.0
Environment=UPLOAD_DIR=/var/lib/tscquestoes/uploads
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=NODE_OPTIONS=--max-old-space-size=768
ExecStart=/usr/local/bin/node server.js
Restart=always
RestartSec=3
TimeoutStopSec=20
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tscquestoes
UMask=0027
MemoryHigh=1100M
MemoryMax=1400M

[Install]
WantedBy=multi-user.target
